# Apply Assistant — local configuration.
# Copy this file to .env (same folder, gitignored) and set the values.

# Absolute path to YOUR job-hunt project folder (the sibling automated
# job-application pipeline). The Apply Assistant writes extracted job postings
# and CV imports here, and runs the job-application-pipeline / job-scout CLI
# turns against it. Required — without it the app boots but shows a "not
# configured" state and does nothing else.
JOB_HUNT_ROOT=

# Optional — override the default ports (see server/src/index.ts and
# client/vite.config.ts for the derivation logic and why these particular
# defaults were chosen to avoid clashing with sibling local apps).
# APPLY_ASSISTANT_PORT=4320
# PORT=5300

# NOTE: no API keys belong here. Contact discovery (Hunter.io) is handled
# inside the job-hunt project's own scripts/.env, invoked by the CLI turn —
# this app never reads HUNTER_API_KEY.
